<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://company.oa/workflow"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             exporter="OA"
             exporterVersion="1.0">
    <process id="oa_leave_approval" name="OA Leave Approval" isExecutable="true">
        <startEvent id="startEvent" name="开始"/>
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="checkDays"/>
        <exclusiveGateway id="checkDays" name="请假天数判断"/>
        <sequenceFlow id="flow2a" sourceRef="checkDays" targetRef="hrFiling">
            <conditionExpression xsi:type="tFormalExpression">${durationDays &lt;= 1}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow2b" sourceRef="checkDays" targetRef="deptHeadApprove">
            <conditionExpression xsi:type="tFormalExpression">${durationDays > 1 &amp;&amp; durationDays &lt;= 3}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow2c" sourceRef="checkDays" targetRef="deptHeadApprove">
            <conditionExpression xsi:type="tFormalExpression">${durationDays > 3}</conditionExpression>
        </sequenceFlow>
        <userTask id="hrFiling" name="HR备案" flowable:assignee="${hrAdminId}"/>
        <sequenceFlow id="flow3" sourceRef="hrFiling" targetRef="endEvent"/>
        <userTask id="deptHeadApprove" name="部门主管审批" flowable:assignee="${deptHeadId}"/>
        <sequenceFlow id="flow4" sourceRef="deptHeadApprove" targetRef="checkDays2"/>
        <exclusiveGateway id="checkDays2" name="是否需要副总审批"/>
        <sequenceFlow id="flow5a" sourceRef="checkDays2" targetRef="hrApprove">
            <conditionExpression xsi:type="tFormalExpression">${durationDays &lt;= 3}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow5b" sourceRef="checkDays2" targetRef="vpApprove">
            <conditionExpression xsi:type="tFormalExpression">${durationDays > 3}</conditionExpression>
        </sequenceFlow>
        <userTask id="vpApprove" name="副总审批" flowable:assignee="${vpId}"/>
        <sequenceFlow id="flow6" sourceRef="vpApprove" targetRef="hrApprove"/>
        <userTask id="hrApprove" name="HR审批" flowable:assignee="${hrAdminId}"/>
        <sequenceFlow id="flow7" sourceRef="hrApprove" targetRef="endEvent"/>
        <endEvent id="endEvent" name="结束"/>
    </process>
</definitions>
